{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "skipLibCheck": true,
    "types": ["node", "@sveltejs/kit"]
  },
  "include": ["src/**/*.js", "tests/**/*.js", "vite.config.js", "api-proxy-target.js"]
}
