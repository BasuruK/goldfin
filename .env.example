# Copy to `.env` in the repo root (gitignored). Docker Compose reads these for Postgres.
# Use simple KEY=value lines (no `export`, one line per key). Special characters in values
# are safest in double quotes. The Go binary loads this file via godotenv; do not rely on
# GNU Make to parse secrets.
#
# Local dev defaults only — change before any shared or deployed environment.
POSTGRES_USER=goldfin
POSTGRES_PASSWORD=goldfin
POSTGRES_DB=goldfin
DATABASE_URL=postgres://goldfin:goldfin@127.0.0.1:5432/goldfin?sslmode=disable
#
# Generate APP_KEY once before the real API/worker store ships (see ADR 0005); optional for
# the current local stub.
APP_KEY=
# Go API bind address (may be 0.0.0.0:8080 in containers).
API_ADDR=127.0.0.1:8080
# Vite `/api` proxy target; defaults to API_ADDR. Use when bind address is not reachable locally.
# API_ORIGIN=http://127.0.0.1:8080
