# Copy to `.env` in the repo root (gitignored). Used by `go run ./cmd/goldfin …` and `pnpm dev`.
# Generate APP_KEY once and keep it stable across api + worker restarts.
APP_KEY=
# Password must match POSTGRES_PASSWORD in docker-compose.yml (default goldfin).
DATABASE_URL=postgres://goldfin:goldfin@127.0.0.1:5432/goldfin?sslmode=disable
# Optional: integration tests only (never point at a dev DB you care about).
TEST_DATABASE_URL=
# Listen address for the Go API; Vite dev proxy uses the same value for `/api`.
API_ADDR=127.0.0.1:8080
