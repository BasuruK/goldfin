# Copy to `.env` in the repo root (gitignored). Docker Compose reads these for Postgres.
# Use simple KEY=value lines (no `export`, one line per key). Compose builds each container's
# DATABASE_URL from the three POSTGRES_ values, so keep special URL characters out of them.
#
# Replace these placeholders for your local database.
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me
#
# Required by worker: standard base64 encoding of 32 random bytes (see ADR 0005).
# Generate once with e.g. `openssl rand -base64 32`; keep the same value for staged Credentials.
APP_KEY=
# Vite `/api` proxy target: a full http(s) origin, no path. Go binds API_ADDR inside Compose.
API_URL=http://127.0.0.1:8080
